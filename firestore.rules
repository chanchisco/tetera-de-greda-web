rules_version = '2';
// Contenido público: texto, precios y URLs de platos, bebidas y galería.
// Los originales, historial y papelera se consultan únicamente mediante API.
// Las mutaciones se validan y registran en /api/contenido (Firebase Admin).
service cloud.firestore {
 match /databases/{database}/documents {
  match /platos/{id} { allow read: if true; allow write: if false; }
  match /bebidas/{id} { allow read: if true; allow write: if false; }
  match /galeria/{id} { allow read: if true; allow write: if false; }
  match /configuracion/{id} {
   allow get: if id in ['portadas','menuDia','imagenesSeccion','historia','galeriaOpciones','destacados'];
   allow list, write: if false;
  }
  match /administradores/{uid} {
   allow get: if request.auth != null && request.auth.uid == uid;
   allow list, write: if false;
  }
  match /sistema/seguridad {
   allow get: if request.auth != null;
   allow list, write: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
