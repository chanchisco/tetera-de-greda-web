rules_version = '2';

// ============================================================
// Reglas de seguridad de Firestore
// Pégalas en: Firebase Console > Firestore Database > Reglas
// ============================================================
// - Cualquier persona (los comensales) puede LEER el menú.
// - Solo un usuario autenticado (el dueño con su login) puede
//   crear, editar o borrar platos y bebidas.
service cloud.firestore {
  match /databases/{database}/documents {

    match /platos/{platoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /bebidas/{bebidaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Cualquier otra colección queda bloqueada por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
