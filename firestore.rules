rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura a cualquier persona (para que la web funcione para el público)
    // Permitir escritura (crear, modificar, borrar) SOLO si el usuario inició sesión
    
    match /platos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /bebidas/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /configuracion/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /galeria/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Bloqueo por defecto para cualquier otra colección (seguridad extra)
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
