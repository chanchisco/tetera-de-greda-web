rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function mfaSatisfied() {
      return !exists(/databases/$(database)/documents/sistema/seguridad)
        || get(/databases/$(database)/documents/sistema/seguridad).data.get('requireMfa', false) != true
        || request.auth.token.firebase.get('sign_in_second_factor', '') == 'totp';
    }
    function activeAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid))
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.activo == true
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.rol in ['completo', 'contenido']
        && mfaSatisfied();
    }
    
    match /platos/{document=**} {
      allow read: if true;
      allow write: if activeAdmin();
    }
    
    match /bebidas/{document=**} {
      allow read: if true;
      allow write: if activeAdmin();
    }
    
    match /configuracion/{document} {
      allow read: if document in ['portadas', 'menuDia', 'imagenesSeccion', 'historia', 'galeriaOpciones'];
      allow write: if activeAdmin() && document in ['portadas', 'menuDia', 'imagenesSeccion', 'historia', 'galeriaOpciones'];
    }
    
    match /galeria/{document=**} {
      allow read: if true;
      allow write: if activeAdmin();
    }

    match /administradores/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /sistema/seguridad {
      allow get: if request.auth != null;
      allow list, write: if false;
    }
    
    // Bloqueo por defecto para cualquier otra colección (seguridad extra)
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
